# syntax=docker/dockerfile:1
FROM node:26.10-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/engine/package.json packages/engine/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter "@fc/api..."
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @fc/api build

# Runtime: single bundled file, no node_modules, non-root.
FROM node:26.10-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/api/dist/index.js ./index.js
COPY db/migrations ./migrations
ENV MIGRATIONS_DIR=/app/migrations
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "index.js"]
