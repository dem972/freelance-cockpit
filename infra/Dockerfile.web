# syntax=docker/dockerfile:1
FROM node:26.10-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/engine/package.json packages/engine/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter "@fc/web..."
COPY packages packages
COPY apps/web apps/web
# AGPL-3.0 §13: a modified deployment must link to its own source.
ARG VITE_SOURCE_URL=""
ENV VITE_SOURCE_URL=${VITE_SOURCE_URL}
RUN pnpm --filter @fc/web build

# Runtime: nginx running as non-root, listening on 8080.
FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
