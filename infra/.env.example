# Copy to infra/.env (git-ignored, chmod 600) and fill in. Never commit the real file.

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
WEB_PORT=8380

# --- Authentication -----------------------------------------------------------
# access: every API call needs a valid Cloudflare Access JWT (production).
# none:   no authentication, for local development only.
AUTH_MODE=access
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=application-audience-tag
ALLOWED_EMAILS=you@example.com

# --- Agents (copilot, reports, rates watch) -------------------------------------
# Shared secret agent → api, internal network only: openssl rand -hex 32
AGENT_API_TOKEN=
# Without a key the app works, the copilot answers that it is disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Weekly rates watch (cron, local time): Monday 06:00
RATES_WATCH_CRON=0 6 * * 1

# --- Cloudflare Tunnel (profile prod) -----------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups (profile prod) -----------------------------------------------------
# Public key only (age1...). Keep the private key OFF this machine.
AGE_RECIPIENT=
BACKUP_AT=03:00
KEEP_DAYS=30
TZ=Europe/Paris
# rclone destination, e.g. remote:my-bucket/finance-cockpit
RCLONE_REMOTE=
S3_PROVIDER=Cloudflare
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
