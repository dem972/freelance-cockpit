# syntax=docker/dockerfile:1
FROM python:3.14.7-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY apps/agent/pyproject.toml apps/agent/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/agent/src ./src
RUN uv sync --frozen --no-dev

# Runtime: same Python, virtualenv only, non-root.
FROM python:3.14.7-slim
RUN useradd --system --uid 10001 --home /app agent
WORKDIR /app
COPY --from=build --chown=agent:agent /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER agent
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/agent/health').status==200 else 1)"
CMD ["uvicorn", "copilot.main:app", "--host", "0.0.0.0", "--port", "8000"]
